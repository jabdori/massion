{
  "name": "massion-desktop",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Massion desktop development shell",
  "author": "Massion contributors",
  "type": "module",
  "main": "dist/launcher.cjs",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "install:electron": "node node_modules/electron/install.js",
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node tests/smoke.mjs",
    "package:mac": "npm run build && electron-builder --mac dir --publish never"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/node": "24.19.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "app.massion.desktop",
    "productName": "Massion",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "core/src",
        "filter": [
          "**/*.ts"
        ]
      },
      {
        "from": "../package.json",
        "to": "core/package.json"
      },
      {
        "from": "../docs/product/screens/copy.ko.json",
        "to": "core/docs/product/screens/copy.ko.json"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "identity": null,
      "target": [
        "dir"
      ],
      "category": "public.app-category.productivity"
    },
    "afterPack": "./fuses.cjs"
  }
}
