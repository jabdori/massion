{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@nimbalyst/runtime": ["./src/vendor/nimbalyst/index.ts"],
      "@nimbalyst/runtime/*": ["./src/vendor/nimbalyst/*"],
      "@nimbalyst/extension-sdk": ["./src/vendor/nimbalyst-extension-sdk/index.ts"],
      "@nimbalyst/extension-sdk/*": ["./src/vendor/nimbalyst-extension-sdk/*"],
      "@nimbalyst/collab-protocol": ["./src/vendor/nimbalyst-collab-protocol/index.ts"],
      "@nimbalyst/collab-adapters": ["./src/vendor/nimbalyst-collab-adapters/index.ts"]
    }
  },
  "include": ["src/vendor/**/*.ts", "src/vendor/**/*.tsx"],
  "exclude": []
}
