{
  "name": "@massion/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Massion AgentOS desktop client",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "tauri:dev": "cargo tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "cargo tauri build --bundles app --config src-tauri/tauri.release.conf.json",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource/geist-mono": "5.3.0",
    "@massion/application": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "@tauri-apps/api": "2.11.1",
    "@xyflow/react": "^12.11.2",
    "cmdk": "^1.1.1",
    "pretendard": "1.3.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-resizable-panels": "^4.12.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "vite": "8.1.4"
  }
}
